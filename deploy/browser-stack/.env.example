# OpenCode remote browser stack — copy to `.env` and fill in. NEVER commit `.env`.
# Two audiences: the compose stack (NEKO_*/STEEL_*/TTYD_* below) and OpenCode
# itself (the OPENCODE_* block at the bottom, set wherever the OpenCode server runs).

# ── neko (shared interactive browser) ───────────────────────────────────────
NEKO_HTTP_PORT=8080
NEKO_CDP_PORT=9223
NEKO_EPR_RANGE=52000-52100
# The address YOUR browser uses to reach CT100 (public IP, or LAN IP for local).
# WebRTC fails silently if this is wrong — see README "WebRTC reachability".
NEKO_NAT1TO1=CHANGE_ME_CT100_IP
NEKO_USER_PASSWORD=change-me-user
NEKO_ADMIN_PASSWORD=change-me-admin
# TURN/STUN as a JSON array (leave [] for same-LAN). Required for remote viewers behind NAT.
# Example: [{"urls":["turn:turn.example.com:3478"],"username":"u","credential":"p"}]
NEKO_ICESERVERS_FRONTEND=[]
NEKO_ICESERVERS_BACKEND=[]

# ── Steel (headless automation lane) ────────────────────────────────────────
STEEL_API_PORT=3000
STEEL_CDP_PORT=9224
STEEL_UI_PORT=5173
STEEL_DOMAIN=localhost:3000
STEEL_CDP_DOMAIN=localhost:9224
STEEL_API_INTERNAL_URL=http://steel-api:3000

# ── ttyd (remote terminal) ──────────────────────────────────────────────────
TTYD_PORT=7681
TTYD_USER=opencode
TTYD_PASSWORD=change-me-ttyd

# ── OpenCode server config (set on the OpenCode host, NOT inside the stack) ──
# These point OpenCode at the stack. Swap 127.0.0.1 for CT100's address when
# OpenCode and the stack are on different hosts. Tokens/passwords stay server-side.
# OPENCODE_BROWSER_STACK=1                          # feature flag; off by default until proven
# OPENCODE_NEKO_URL=http://127.0.0.1:8080           # WebRTC viewer + signalling
# OPENCODE_NEKO_CDP_URL=http://127.0.0.1:9223       # CDP (via socat sidecar)
# OPENCODE_NEKO_PASSWORD=change-me-user             # neko member password (server-side only)
# OPENCODE_STEEL_URL=http://127.0.0.1:3000          # Steel session API
# OPENCODE_STEEL_VIEWER_URL=http://127.0.0.1:5173   # Steel embeddable viewer
# OPENCODE_TTYD_URL=http://127.0.0.1:7681           # ttyd terminal
